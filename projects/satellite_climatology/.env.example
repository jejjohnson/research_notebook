# Acquired layer — external holdings PostGIS DB (PRIVATE; values go in .env, which is gitignored).
# Copy the relevant values into:
#   projects/satellite_climatology/src/satellite_climatology/.env
# Nothing here is read unless you enable "Show Acquired" in the app.

# Either set a full SQLAlchemy URL ...
# COVERAGE_DB_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# ... or the discrete parts:
COVERAGE_DB_HOST=
COVERAGE_DB_PORT=5432
COVERAGE_DB_NAME=
COVERAGE_DB_USER=
COVERAGE_DB_PASSWORD=
COVERAGE_DB_SCHEMA=public
COVERAGE_DB_SSLMODE=require

# Map these generic names to YOUR table's real columns (the real names stay in .env only).
COVERAGE_TILES_TABLE=tiles
COVERAGE_TILES_GEOM=geometry
COVERAGE_TILES_DATE=acquired_at
COVERAGE_TILES_SENSOR=sensor
COVERAGE_TILES_CLOUD=cloud_cover
