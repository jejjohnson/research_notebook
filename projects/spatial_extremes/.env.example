# Climate Data Store (CDS) credentials for the real-data path.
# Copy to the repo root as `.env` (already gitignored) and fill in your key.
# Requires a free CDS account and acceptance of the in-situ land dataset licence:
#   https://cds.climate.copernicus.eu/datasets/insitu-observations-surface-land
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your-key-here

# Optional: redirect the cached archive elsewhere (default: this project's data/).
# CDS_INSITU_SCRATCH_ROOT=/path/to/scratch
